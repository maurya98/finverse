{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@finverse/logger": ["../../../libs/logger"],
      "@finverse/logger/*": ["../../../libs/logger/*"]
    },
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "references": [
    {
      "path": "../../../libs/logger"
    }
  ],
  "include": ["src/**/*"]
}
